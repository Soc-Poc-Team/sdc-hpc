use flake . --impure

export TMPDIR="${TMPDIR:-/tmp}"
mkdir -p "$TMPDIR"

SECRETS_FILE="secrets/${USER}.json"
if [[ -f "$SECRETS_FILE" ]]; then
	echo "Loading secrets from: $SECRETS_FILE"
	exports="$(
		sops -d "$SECRETS_FILE" | jq -r '
			paths(scalars) as $p |
			($p | map(tostring | ascii_upcase) | join("_")) as $name |
			getpath($p) as $val |
			"\($name)=\(@sh "\($val)")"
		'
	)"
	while IFS= read -r line; do
		export "$line"
	done <<< "$exports"
else
	echo "-------------------------------"
	echo "No secrets file for $USER at $SECRETS_FILE"
	echo "Create one from secrets/template.json and encrypt with sops."
	echo "You can use the \`create-secret\` command to do that for you!"
	echo "-------------------------------"
fi
