#!/usr/bin/env bash
watch_file secrets/*
use flake . --impure

export TMPDIR="${TMPDIR:-/tmp}"
mkdir -p "$TMPDIR"

SECRETS_FILE="secrets/${USER}.json"
if [[ -f $SECRETS_FILE ]]; then
  echo "Зареждане на тайни от: $SECRETS_FILE"
  SDC_SECRETS=$(sops -d "$SECRETS_FILE" | jq -c)
  export SDC_SECRETS
  # Export tailscale apikey and tailnet for in devshell curling of the api
  TAILSCALE_APIKEY=$(echo "$SDC_SECRETS" | jq -r ".tailscale.apiKey")
  export TAILSCALE_APIKEY
  TAILSCALE_DOMAIN=$(echo "$SDC_SECRETS" | jq -r ".tailscale.domain")
  export TAILSCALE_DOMAIN
else
  echo "-------------------------------"
  echo "Няма файл със тайни за $USER в $SECRETS_FILE"
  echo "Създайте такъв от secrets/template.json и го шифровайте с sops."
  echo "Можете да използвате командата 'create-secret', за да го направите!"
  echo "-------------------------------"
fi

./dev/setup-tmux.sh -n
