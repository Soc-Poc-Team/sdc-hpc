#!/usr/bin/env bash
watch_file secrets/*
use flake . --impure

export TMPDIR="${TMPDIR:-/tmp}"
mkdir -p "$TMPDIR"

SECRETS_FILE="secrets/${USER}.json"
if [[ -f $SECRETS_FILE ]]; then
  echo "Loading secrets from: $SECRETS_FILE"
  SDC_SECRETS=$(sops -d "$SECRETS_FILE" | jq -c)
  export SDC_SECRETS
  # Export tailscale apikey and tailnet for in devshell curling of the api
  TAILSCALE_APIKEY=$(echo "$SDC_SECRETS" | jq -r ".tailscale.apiKey")
  export TAILSCALE_APIKEY
  TAILSCALE_DOMAIN=$(echo "$SDC_SECRETS" | jq -r ".tailscale.domain")
  export TAILSCALE_DOMAIN
else
  echo "-------------------------------"
  echo "No secrets file for $USER at $SECRETS_FILE"
  echo "Create one from secrets/template.json and encrypt with sops."
  echo "You can use the 'create-secret' command to do that for you!"
  echo "-------------------------------"
fi

./dev/setup-tmux.sh -n
