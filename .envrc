#!/usr/bin/env bash
use flake . --impure

export TMPDIR="${TMPDIR:-/tmp}"
mkdir -p "$TMPDIR"

SECRETS_FILE="secrets/${USER}.json"
if [[ -f $SECRETS_FILE ]]; then
  echo "Loading secrets from: $SECRETS_FILE"
  SDC_SECRETS=$(sops -d "$SECRETS_FILE" | jq -c)
  export SDC_SECRETS
else
  echo "-------------------------------"
  echo "No secrets file for $USER at $SECRETS_FILE"
  echo "Create one from secrets/template.json and encrypt with sops."
  echo "You can use the 'create-secret' command to do that for you!"
  echo "-------------------------------"
fi
